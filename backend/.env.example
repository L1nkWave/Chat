# Dùng khi chạy toàn bộ stack bằng docker compose (dùng tên service trong mạng Docker, không dùng localhost).
# Copy file này thành backend/.env, thay các giá trị <...> bằng giá trị thật.
# Không commit file .env thật lên GitHub (đã có trong .gitignore).

USERS_DB_URL=jdbc:postgresql://users-db:5432/lw-users
DB_USER=postgres
USERS_DB_PASSWORD=change-me

CHAT_DB_URL=mongodb://chat-db:27017/linkwave?replicaSet=rs0

DISCOVERY_URL=http://discovery-service:8761/eureka/

ORIGINS=http://localhost:3000,http://localhost

# chat-service: id của tài khoản sgu_bot trong bảng users (lấy bằng: select id from users where username = 'sgu_bot';)
# Đổi mỗi khi tạo lại sgu_bot sau khi reset DB. Để 0 thì không có hội thoại bot.
BOT_USER_ID=1

# Khóa dùng chung giữa các service (≥ 32 ký tự), phải giống nhau ở mọi service
INTERNAL_SERVICE_KEY=<chuoi-ngau-nhien-it-nhat-32-ky-tu>

# user-service: mã hóa CCCD (AES-GCM) và chỉ mục tra cứu (HMAC). Mỗi khóa là base64 của đúng 32 byte.
CCCD_ENCRYPTION_KEY=<base64-cua-32-byte-ngau-nhien>
CCCD_INDEX_KEY=<base64-cua-32-byte-ngau-nhien>

# auth-service: xác thực 2FA
TOTP_KEY_1=<base64-cua-32-byte-ngau-nhien>
TOTP_KEY_VERSION=1
TWO_FACTOR_CHALLENGE_SECRET=<chuoi-ngau-nhien-it-nhat-32-ky-tu>