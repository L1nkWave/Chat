# Copy file này thành frontend/.env.local trước khi chạy frontend.

# Địa chỉ api-gateway. Next.js chuyển tiếp /api/* tới đây (chỉ dùng phía server).
API_GATEWAY_URL=http://localhost:8080

# Địa chỉ WebSocket của ws-server (đường dẫn /ws, cần ticket từ /api/v1/ws-tickets).
NEXT_PUBLIC_WS_URL=ws://localhost:9090/ws
